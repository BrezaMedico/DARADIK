# ============================================================================
# KONFIGURASI BACKEND AI CHATBOT BOSP & PIPER TTS (JANGAN TARUH DI FRONT-END)
# ============================================================================
GEMINI_API_KEY=[ISI_DI_SERVER_JANGAN_DI_FRONTEND]
# Catatan: gemini-2.5-* sudah deprecated di SDK @google/genai terbaru,
# sehingga disubstitusi ke gemini-3.8-flash (atau gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Konfigurasi Piper TTS Bahasa Indonesia (id_ID-news_tts-medium)
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=./server/models/id_ID-news_tts-medium.onnx

# ============================================================================
# KONFIGURASI KEAMANAN ENKRIPSI LAPORAN & CAPTCHA (SERVER-SIDE ONLY)
# ============================================================================
# Kunci Master Enkripsi Laporan Masyarakat (AES-256-GCM, 32 bytes Base64).
# WAJIB dikonfigurasi di server/Render. Generate kunci baru via:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REPORT_ENCRYPTION_KEY=[ISI_DENGAN_RANDOM_BASE64_32_BYTES]
REPORT_ENCRYPTION_ACTIVE_KEY_ID=k1

# Dukungan Rotasi Kunci (Opsional, format JSON map keyId ke base64 key):
# REPORT_ENCRYPTION_KEYS={"k1":"old_key_base64...","k2":"new_key_base64..."}

# Secret Token CAPTCHA HMAC-SHA256 (Minimal 16 karakter acak)
CAPTCHA_SECRET=[ISI_DENGAN_RANDOM_SECRET_KEY_MINIMAL_16_KARAKTER]

# ============================================================================
# KONFIGURASI SUPABASE ADMIN BACKEND (SERVER-SIDE ONLY - JANGAN DI FRONTEND)
# ============================================================================
SUPABASE_URL=https://eteimuixvdbcnzokckff.supabase.co
# Service role key diperlukan backend untuk RPC keamanan (svc_*) & Storage admin
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=[ISI_DENGAN_SERVICE_ROLE_KEY_DARI_SUPABASE_DASHBOARD]

# ============================================================================
# KONFIGURASI SUPABASE FRONTEND CLIENT (PUBLIC ACCESS)
# ============================================================================
VITE_SUPABASE_URL=https://eteimuixvdbcnzokckff.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__L_ZAHdcCN9NXZn1myW90A_QfDZyD8J

# ============================================================================
# KONFIGURASI PRISMA ORM (SUPABASE POSTGRESQL POOLER)
# ============================================================================
# Ganti [YOUR-DATABASE-PASSWORD] dengan password database Supabase project Anda:
DATABASE_URL="postgresql://postgres.eteimuixvdbcnzokckff:[YOUR-DATABASE-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.eteimuixvdbcnzokckff:[YOUR-DATABASE-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
