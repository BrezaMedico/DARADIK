# ============================================================================
# KONFIGURASI BACKEND AI CHATBOT BOSP & PIPER TTS (JANGAN TARUH DI FRONT-END)
# ============================================================================
GEMINI_API_KEY=[ISI_DI_SERVER_JANGAN_DI_FRONTEND]
# Catatan: gemini-2.5-* sudah deprecated di SDK @google/genai terbaru,
# sehingga disubstitusi ke gemini-3.8-flash (atau gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Konfigurasi Piper TTS Bahasa Indonesia (id_ID-news_tts-medium)
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=./server/models/id_ID-news_tts-medium.onnx

